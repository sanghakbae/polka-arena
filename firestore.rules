rules_version = '2';

// Polka Arena's Firestore holds nothing but a cache of what is already public on
// chain, so reads are open. Writes are closed to every client: the only writer is
// the indexer, which authenticates with a service account and therefore bypasses
// these rules entirely.
//
// This is the whole security model. If browsers could write here, a player could
// forge their own battle history and season standings, since nothing in a client
// write is verifiable.
service cloud.firestore {
  match /databases/{database}/documents {

    match /heroes/{address} {
      allow read: if true;
      allow write: if false;
    }

    match /fights/{fightId} {
      allow read: if true;
      allow write: if false;
    }

    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if false;
    }

    match /meta/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Anything not listed above is denied outright rather than inheriting a
    // permissive default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
